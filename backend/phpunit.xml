<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Testes que falam com o MySQL de verdade (concorrencia real entre
             conexoes). Ficam fora do run padrao pelo grupo `mysql` abaixo. -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <groups>
        <exclude>
            <!-- A suite padrao roda SQLite em memoria. O grupo `mysql` abre
                 conexoes reais e escreve na base de desenvolvimento, entao so'
                 roda sob demanda, passando o grupo na linha de comando. -->
            <group>mysql</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Storage proprio da suite. Generaliza o que antes so' valia para as
             views compiladas: testes rodam como o usuario do dev, mas
             storage/ pertence a www-data e storage/app/private e' 0750 — o
             grupo nao escreve. Resultado: todo teste que grava arquivo
             (thumbnail de PDF, foto de equipamento, PDF de orcamento) morria
             com "mkdir(): Permission denied", e os que sobreviviam deixavam
             lixo no storage real (157 MB / 14 mil entradas acumuladas).
             Aqui a suite escreve num diretorio que ela mesma possui. -->
        <env name="LARAVEL_STORAGE_PATH" value="./.phpunit-storage"/>
        <!-- Mantido explicito: sem isto, testes (usuario do dev) e site
             (www-data) compilam Blade no MESMO diretorio e quem chegar depois
             quebra com "touch(): Utime failed". -->
        <env name="VIEW_COMPILED_PATH" value="./.phpunit-storage/framework/views"/>
        <!-- APP_URL fixo: sem isto os testes herdam a URL real do .env e o
             self-check de integracoes faz chamada HTTP REAL ao servidor dev
             (fora do Http::fake, que so cobre 127.0.0.1:8000). -->
        <env name="APP_URL" value="http://127.0.0.1:8000"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- Coletor de bancada com valores fixos: sem isto a suite herda o
             .env da maquina do dev (COLLECTOR_LOCAL_ROOT_LINUX aponta para a
             storage real aqui) e os testes que afirmam o caminho padrao
             falham em qualquer maquina que tenha a variavel definida. Mesmo
             raciocinio do APP_URL logo acima. -->
        <env name="COLLECTOR_API_TOKEN" value=""/>
        <env name="COLLECTOR_LOCAL_ROOT" value="C:\JovemTechBenchCollector"/>
        <env name="COLLECTOR_LOCAL_ROOT_LINUX" value="/home/JovemTechBenchCollector"/>
        <env name="COLLECTOR_PUBLISHED_ROOT" value=""/>
        <env name="COLLECTOR_PUBLISHED_ROOT_LINUX" value=""/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="DOCUMENT_SIGNATURES_REQUIRED" value="false"/>
        <!-- File manager tests never inherit mutable production switches. -->
        <env name="FILE_MANAGER_MODE" value="off"/>
        <env name="FILE_MANAGER_ENABLED_CATEGORIES" value=""/>
        <env name="FILE_MANAGER_ALLOW_WRITES" value="false"/>
        <env name="FILE_MANAGER_ALLOW_SCANNER" value="false"/>
        <env name="FILE_MANAGER_ALLOW_MUTATING_RECONCILE" value="false"/>
        <env name="FILE_MANAGER_ALLOW_ADMIN_STATE_MUTATIONS" value="false"/>
        <env name="FILE_MANAGER_AUTOMATIC_SYNC_ENABLED" value="false"/>
        <env name="CHAT_DB_CONNECTION" value="sqlite"/>
        <env name="CHAT_DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
