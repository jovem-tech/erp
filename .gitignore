# Dependencias e build
vendor/
node_modules/
dist/
build/
coverage/

# Ambientes
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local

# Logs e arquivos temporarios
*.log
*.tmp
*.swp

# Futuro backend e frontends
backend/vendor/
backend/bootstrap/cache/
frontends/**/node_modules/
frontends/**/.next/
frontends/**/dist/

# Frontend/BFF legado clonado do sistema-hml
frontend/**/vendor/
frontend/**/writable/
frontend/**/public/uploads/
frontend/**/public/assets/agents/
frontend/**/documentacao/**/node_modules/
frontend/**/.env
frontend/**/.env.*

# Storage Laravel
backend/storage/app/private/*
!backend/storage/app/private/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore

# Cache de fontes do dompdf (DANFSe). E gerado em runtime pelo www-data --
# NfseDanfseRenderer::prepararCacheDeFontes() cria o diretorio e o dompdf
# escreve as metricas .ufm/.ufm.json na primeira emissao. As fontes de origem
# ficam versionadas em backend/resources/fonts/. Versionar o cache alem de
# inchar o repositorio quebra a promocao develop -> main (os arquivos voltam a
# existir no disco e o git recusa sobrescrever arquivo nao rastreado) e deixa
# o cache com dono errado (administrador em vez de www-data).
backend/storage/fonts/

# Cache incremental do tsc -- regerado a cada type-check, so gera ruido no diff
*.tsbuildinfo

# Backups de banco (podem conter dados reais de clientes - nunca versionar)
backend/storage/backups/
/backend/storage/backups/*.sql
*.sql
*.sql.gz

# Sistema e editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Quarentena de seguranca (scripts perigosos isolados em 2026-06-25, nunca versionar)
/_quarentena-seguranca-*/
